<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE nta PUBLIC '-//Uppaal Team//DTD Flat System 1.1//EN' 'http://www.it.uu.se/research/group/darts/uppaal/flat-1_2.dtd'>
<nta>
<declaration>// One turn after "send", in time (seconds). specs/turns/TurnQueue.tla has the states; this has the clocks.
// SERVER = false: the page runs the turn (DefaultChatScreen.svelte): the helpers and the prompt (HELP), the model on the server's
//   stream job (GEN), the tidy and the save (TIDY). A page that is frozen (iOS: another app, the screen locked) does nothing; when
//   it thaws, the step it was in starts again (a helper request cut by the freeze is lost; the stream job is not).
// SERVER = true: the server's turn worker runs the same steps in a page that is never frozen, after loading the save (RELOAD).
//   The worker's process beats every BEAT..BEATMAX s (an event-loop stall stretches it); a turn whose worker has not beaten for
//   LEASE s is taken back and run again by a second run (same key: the model job is reused). The worker may die once (CRASH).
const bool SERVER = @SERVER@;
const int LEASE = @LEASE@;
const int BEAT = 10;
const int BEATMAX = 25;   // measured stall budget: a 7 MB save decoded on the main thread blocks the loop for seconds
const int RELOAD = 30;
const int HELP = 40;      // two lore-librarian helper calls of 20 s at most (loreIndexPage.ts TIMEOUT_MS)
const int GEN = 120;
const int TIDY = 5;
const int D = 2 * (RELOAD + HELP + GEN + TIDY) + @LEASE@;   // the promise: the reply is in the chat on the server by then

int[0,1000] awayFor = 0;
bool saved = false;
int[0,2] running = 0;     // runs of this turn that are working on it now
bool crashed = false;
clock t;                  // since send
clock a;                  // the phone away
clock p;                  // the page's current step
clock w;                  // a server run's current step
clock h;                  // since the worker's last beat
broadcast chan away, back, crash;
chan relet;
</declaration>

<template>
<name>Phone</name>
<location id="f0"><name>Here</name></location>
<location id="f1"><name>Away</name><label kind="invariant">a &lt;= awayFor</label></location>
<location id="f2"><name>Done</name></location>
<init ref="f0"/>
<transition><source ref="f0"/><target ref="f1"/>
  <label kind="select">k : int[0,2]</label>
  <label kind="assignment">awayFor = (k == 0 ? 10 : (k == 1 ? 60 : 1000)), a = 0</label>
  <label kind="synchronisation">away!</label></transition>
<transition><source ref="f1"/><target ref="f2"/>
  <label kind="guard">a == awayFor</label>
  <label kind="synchronisation">back!</label></transition>
</template>

<template>
<name>PageTurn</name>
<location id="q0"><name>Assemble</name><label kind="invariant">p &lt;= HELP</label></location>
<location id="q1"><name>Generate</name><label kind="invariant">p &lt;= GEN</label></location>
<location id="q2"><name>Tidy</name><label kind="invariant">p &lt;= TIDY</label></location>
<location id="q3"><name>FrozenA</name></location>
<location id="q4"><name>FrozenG</name></location>
<location id="q5"><name>FrozenT</name></location>
<location id="q6"><name>Saved</name></location>
<location id="q7"><name>Off</name></location>
<init ref="q0"/>
<transition><source ref="q0"/><target ref="q7"/><label kind="guard">SERVER</label></transition>
<transition><source ref="q0"/><target ref="q1"/><label kind="guard">!SERVER</label><label kind="assignment">p = 0</label></transition>
<transition><source ref="q1"/><target ref="q2"/><label kind="assignment">p = 0</label></transition>
<transition><source ref="q2"/><target ref="q6"/><label kind="assignment">saved = true</label></transition>
<transition><source ref="q0"/><target ref="q3"/><label kind="guard">!SERVER</label><label kind="synchronisation">away?</label></transition>
<transition><source ref="q1"/><target ref="q4"/><label kind="synchronisation">away?</label></transition>
<transition><source ref="q2"/><target ref="q5"/><label kind="synchronisation">away?</label></transition>
<transition><source ref="q3"/><target ref="q0"/><label kind="synchronisation">back?</label><label kind="assignment">p = 0</label></transition>
<transition><source ref="q4"/><target ref="q1"/><label kind="synchronisation">back?</label><label kind="assignment">p = 0</label></transition>
<transition><source ref="q5"/><target ref="q2"/><label kind="synchronisation">back?</label><label kind="assignment">p = 0</label></transition>
</template>

<template>
<name>Run</name>
<parameter>const int first</parameter>
<location id="r8"><name>Start</name><committed/></location>
<location id="r0"><name>Wait</name></location>
<location id="r1"><name>Reload</name><label kind="invariant">w &lt;= RELOAD</label></location>
<location id="r2"><name>Assemble</name><label kind="invariant">w &lt;= HELP</label></location>
<location id="r3"><name>Generate</name><label kind="invariant">w &lt;= GEN</label></location>
<location id="r4"><name>Tidy</name><label kind="invariant">w &lt;= TIDY</label></location>
<location id="r5"><name>Saved</name></location>
<location id="r6"><name>Dead</name></location>
<location id="r7"><name>Off</name></location>
<init ref="r8"/>
<transition><source ref="r8"/><target ref="r7"/><label kind="guard">!SERVER</label></transition>
<transition><source ref="r8"/><target ref="r1"/><label kind="guard">SERVER &amp;&amp; first == 1</label><label kind="assignment">w = 0, h = 0, running++</label></transition>
<transition><source ref="r8"/><target ref="r0"/><label kind="guard">SERVER &amp;&amp; first == 0</label></transition>
<transition><source ref="r0"/><target ref="r1"/><label kind="guard">SERVER &amp;&amp; first == 0</label><label kind="synchronisation">relet?</label><label kind="assignment">w = 0, h = 0, running++</label></transition>
<transition><source ref="r1"/><target ref="r2"/><label kind="assignment">w = 0</label></transition>
<transition><source ref="r2"/><target ref="r3"/><label kind="assignment">w = 0</label></transition>
<transition><source ref="r3"/><target ref="r4"/><label kind="assignment">w = 0</label></transition>
<transition><source ref="r4"/><target ref="r5"/><label kind="guard">!saved</label><label kind="assignment">saved = true, running--</label></transition>
<transition><source ref="r4"/><target ref="r5"/><label kind="guard">saved</label><label kind="assignment">running--</label></transition>
<transition><source ref="r1"/><target ref="r6"/><label kind="guard">first == 1 &amp;&amp; !crashed</label><label kind="synchronisation">crash!</label><label kind="assignment">crashed = true, running--</label></transition>
<transition><source ref="r2"/><target ref="r6"/><label kind="guard">first == 1 &amp;&amp; !crashed</label><label kind="synchronisation">crash!</label><label kind="assignment">crashed = true, running--</label></transition>
<transition><source ref="r3"/><target ref="r6"/><label kind="guard">first == 1 &amp;&amp; !crashed</label><label kind="synchronisation">crash!</label><label kind="assignment">crashed = true, running--</label></transition>
</template>

<template>
<name>Lease</name>
<location id="l0"><name>Held</name><label kind="invariant">h &lt;= BEATMAX</label></location>
<location id="l3"><name>Orphan</name><label kind="invariant">h &lt;= LEASE</label></location>
<location id="l1"><name>Relet</name></location>
<location id="l2"><name>Off</name></location>
<init ref="l0"/>
<transition><source ref="l0"/><target ref="l2"/><label kind="guard">!SERVER || saved</label></transition>
<!-- the worker's process beats BEAT..BEATMAX s after its last beat while its run is alive -->
<transition><source ref="l0"/><target ref="l0"/><label kind="guard">SERVER &amp;&amp; h &gt;= BEAT &amp;&amp; !saved</label><label kind="assignment">h = 0</label></transition>
<!-- a lease shorter than the longest gap between beats runs out under a worker that is alive -->
<transition><source ref="l0"/><target ref="l1"/><label kind="guard">SERVER &amp;&amp; h &gt;= LEASE &amp;&amp; !saved</label><label kind="synchronisation">relet!</label></transition>
<transition><source ref="l0"/><target ref="l3"/><label kind="synchronisation">crash?</label></transition>
<transition><source ref="l3"/><target ref="l1"/><label kind="guard">h == LEASE</label><label kind="synchronisation">relet!</label></transition>
</template>

<template>
<name>Watch</name>
<location id="o0"><name>Wait</name><label kind="invariant">t &lt;= D + 1</label></location>
<location id="o1"><name>Ok</name></location>
<location id="o2"><name>Late</name></location>
<init ref="o0"/>
<transition><source ref="o0"/><target ref="o1"/><label kind="guard">saved</label></transition>
<transition><source ref="o0"/><target ref="o2"/><label kind="guard">t &gt; D &amp;&amp; !saved</label></transition>
</template>

<system>
phone = Phone();
page = PageTurn();
run1 = Run(1);
run2 = Run(0);
lease = Lease();
watch = Watch();
system phone, page, run1, run2, lease, watch;
</system>
</nta>
