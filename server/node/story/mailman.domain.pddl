; Infinite Mailman / Người Đưa Thư Khủng Bố as the Fate Simulator card plays it (Module 02 Delivery worlds, Module 03 Stamps and
; post points, Module 04 Progression; lore "Postman ranks and advancement", "Ghost Market"). The rules a plan must respect:
;  - a package comes and takes the postman into a delivery world; the way out is the main-line mission, which has to be found
;    first; leaving brings the reward box (the "package" in reality), and opening it pays points and stamps
;  - trainee -> low-rank only by opening the reward box of the trainee world (that also brings the stamp book); low -> mid-rank only
;    through an advancement world, whose special mission comes before the main line
;  - the Ghost Market opens once more than 60 points have been earned in all (here: three reward boxes), with a stamp book
;  - silver stamps need a synthesis recipe; a life stamp needs mid-rank and a silver stamp
(define (domain mailman)
  (:requirements :strips :typing :negative-preconditions)
  (:types tally)
  (:predicates
    (in-reality) (in-world) (in-market) (has-package) (advancement-package) (advancement-world)
    (mission-given) (mission-done) (special-mission-given) (special-done) (reward-box) (advancement-box)
    (trainee) (low-rank) (mid-rank) (has-book)
    (earned ?t - tally) (next-tally ?a ?b - tally) (market-open ?t - tally)
    (has-stamp) (has-recipe) (silver-stamp) (life-stamp))

  (:action take-package :parameters ()
    :precondition (and (in-reality) (not (has-package)) (not (reward-box)) (not (advancement-box)))
    :effect (has-package))
  (:action take-advancement-package :parameters ()
    :precondition (and (in-reality) (low-rank) (not (has-package)) (not (reward-box)) (not (advancement-box)))
    :effect (and (has-package) (advancement-package)))
  (:action enter-world :parameters ()
    :precondition (and (in-reality) (has-package) (not (advancement-package)))
    :effect (and (in-world) (not (in-reality)) (not (has-package))))
  (:action enter-advancement-world :parameters ()
    :precondition (and (in-reality) (has-package) (advancement-package))
    :effect (and (in-world) (advancement-world) (not (in-reality)) (not (has-package)) (not (advancement-package))))

  (:action find-mission :parameters ()
    :precondition (and (in-world) (not (mission-given)))
    :effect (mission-given))
  (:action receive-special-mission :parameters ()
    :precondition (and (in-world) (advancement-world) (not (special-mission-given)))
    :effect (special-mission-given))
  (:action complete-special-mission :parameters ()
    :precondition (and (in-world) (advancement-world) (special-mission-given))
    :effect (special-done))
  (:action deliver :parameters ()
    :precondition (and (in-world) (mission-given) (not (advancement-world)))
    :effect (mission-done))
  (:action deliver-advancement :parameters ()
    :precondition (and (in-world) (mission-given) (advancement-world) (special-done))
    :effect (mission-done))
  (:action return :parameters ()
    :precondition (and (in-world) (mission-done) (not (advancement-world)))
    :effect (and (in-reality) (reward-box) (not (in-world)) (not (mission-given)) (not (mission-done))))
  (:action return-advanced :parameters ()
    :precondition (and (in-world) (mission-done) (advancement-world))
    :effect (and (in-reality) (advancement-box) (not (in-world)) (not (advancement-world)) (not (mission-given)) (not (mission-done))
                 (not (special-mission-given)) (not (special-done))))

  (:action open-trainee-box :parameters (?a ?b - tally)
    :precondition (and (in-reality) (reward-box) (trainee) (earned ?a) (next-tally ?a ?b))
    :effect (and (not (reward-box)) (not (trainee)) (low-rank) (has-book) (earned ?b) (not (earned ?a))))
  (:action open-reward-box :parameters (?a ?b - tally)
    :precondition (and (in-reality) (reward-box) (not (trainee)) (earned ?a) (next-tally ?a ?b))
    :effect (and (not (reward-box)) (has-stamp) (earned ?b) (not (earned ?a))))
  (:action open-reward-box-at-cap :parameters (?a - tally)
    :precondition (and (in-reality) (reward-box) (not (trainee)) (earned ?a) (market-open ?a))
    :effect (and (not (reward-box)) (has-stamp)))
  (:action open-advancement-box :parameters ()
    :precondition (and (in-reality) (advancement-box) (low-rank))
    :effect (and (not (advancement-box)) (not (low-rank)) (mid-rank) (has-stamp)))

  (:action enter-ghost-market :parameters (?t - tally)
    :precondition (and (in-reality) (has-book) (earned ?t) (market-open ?t) (not (reward-box)) (not (advancement-box)))
    :effect (and (in-market) (not (in-reality))))
  (:action leave-ghost-market :parameters ()
    :precondition (in-market)
    :effect (and (in-reality) (not (in-market))))
  (:action buy-stamp :parameters ()
    :precondition (in-market)
    :effect (has-stamp))
  (:action buy-recipe :parameters ()
    :precondition (in-market)
    :effect (has-recipe))
  (:action synthesize-silver :parameters ()
    :precondition (and (in-reality) (has-book) (has-stamp) (has-recipe))
    :effect (silver-stamp))
  (:action fuse-life-stamp :parameters ()
    :precondition (and (mid-rank) (silver-stamp) (not (life-stamp)))
    :effect (and (life-stamp) (not (silver-stamp)))))
